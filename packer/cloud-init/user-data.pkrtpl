#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true
preserve_hostname: false
ssh_pwauth: false

users:
  - name: ansible
    gecos: Automation
    groups: wheel
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
